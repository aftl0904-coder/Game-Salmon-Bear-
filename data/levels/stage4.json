    { "id": "S5", "role": "twist", "x0": 1900, "x1": 2400, "note": "電單車追逐段（用鋼架平台＋的士怪密度加大嘅一般關卡機制表達——撞到只係慢，冇傷害，重用 BikeScene 留待下一批）。" },
    { "id": "S6", "role": "rest-twist", "x0": 2400, "x1": 3040, "note": "喪事班車段（尊重處理）：霧中一架安靜嘅班車駛過，冇敵人冇音樂，只有雨聲同引擎聲。之後蜜僵數量減少。" },
    { "id": "S7", "role": "rest", "x0": 3040, "x1": 3180, "note": "咖啡車＋金鮭。" },
    { "id": "S8", "role": "boss", "x0": 3180, "x1": 3800, "note": "泥鬃（電單車工頭）。" }
